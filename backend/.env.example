# ---- Database ----
# Local MySQL (create the database first:  CREATE DATABASE travelmate;)
#   DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/travelmate
# Aiven / cloud MySQL: paste the Service URI. mysql:// is converted automatically. Then set DB_SSL=true
#   DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
#   DB_SSL=true
# Leave DATABASE_URL empty to use a local SQLite file (travelmate.db), handy for quick testing.
DATABASE_URL=
DB_SSL=

# ---- Frontend address (only needed when deployed) ----
# FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=
